# syntax=docker/dockerfile:1
#
# Build context for every stage below is the project root, e.g.:
#   docker build -f docker/dockerfile --target prod .

##############################################################################
# base: PHP/Apache runtime shared by the "dev" and "prod" targets
##############################################################################
FROM php:8.2-apache AS base

RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       locales apt-utils git libicu-dev g++ libpng-dev libxml2-dev libzip-dev libonig-dev libxslt-dev curl gnupg unzip \
    && rm -rf /var/lib/apt/lists/*

RUN echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    echo "fr_FR.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen

RUN docker-php-ext-configure intl \
    && docker-php-ext-install pdo pdo_mysql gd opcache intl zip calendar dom mbstring xsl \
    && pecl install apcu && docker-php-ext-enable apcu

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN a2enmod rewrite
COPY docker/vhosts.conf /etc/apache2/sites-available/000-default.conf

RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.interned_strings_buffer=16'; \
  } > /usr/local/etc/php/conf.d/opcache-prod.ini \
  && echo 'memory_limit=512M' > /usr/local/etc/php/conf.d/memory.ini

WORKDIR /var/www

##############################################################################
# dev: local development image (source code is bind-mounted at runtime)
##############################################################################
FROM base AS dev

RUN curl -1sLf 'https://dl.cloudsmith.io/public/symfony/stable/setup.deb.sh' | bash \
    && apt-get install -y --no-install-recommends symfony-cli \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g yarn \
    && rm -rf /var/lib/apt/lists/*

RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.validate_timestamps=1'; \
    echo 'opcache.revalidate_freq=0'; \
  } > /usr/local/etc/php/conf.d/opcache-dev.ini

RUN chown -R www-data:www-data /var/www

##############################################################################
# frontend_builder: compile Webpack Encore assets for production
##############################################################################
FROM node:20-alpine AS frontend_builder

WORKDIR /app

COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY webpack.config.js ./
COPY assets ./assets
RUN yarn build

##############################################################################
# vendor: install PHP dependencies without dev packages
##############################################################################
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-progress \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

##############################################################################
# prod: lean, self-contained production image
##############################################################################
FROM base AS prod

ENV APP_ENV=prod \
    APP_DEBUG=0

COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=frontend_builder /app/public/build ./public/build

RUN mkdir -p var/cache var/log public/uploads public/images/activity \
    && composer dump-autoload --no-dev --optimize --classmap-authoritative \
    && chown -R www-data:www-data var public/uploads public/images/activity
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

ENTRYPOINT ["docker-entrypoint"]
CMD ["apache2-foreground"]
